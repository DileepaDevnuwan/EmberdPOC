    "sqlQuery": "SELECT sh.\"Id\", sh.\"InvoiceNo\", sh.\"InvoiceDate\", sh.\"Status\", sh.\"SubTotal\", sh.\"DiscountAmount\", sh.\"TaxAmount\", sh.\"TotalAmount\", sh.\"PaidAmount\", sh.\"BalanceAmount\", sh.\"Remarks\", cu.\"CustomerCode\", cu.\"CustomerName\", cu.\"Phone\", cu.\"Email\", cu.\"CreditLimit\", ct.\"TownName\", cc.\"CountryName\", se.\"EmployeeCode\", se.\"EmployeeName\", se.\"Designation\", co.\"CompanyCode\", co.\"CompanyName\" FROM \"Inventory\".\"SaleHeadTable\" sh JOIN \"Inventory\".\"CustomerTable\" cu ON cu.\"Id\" = sh.\"CustomerId\" LEFT JOIN \"Inventory\".\"Town\" ct ON ct.\"Id\" = cu.\"TownId\" LEFT JOIN \"Inventory\".\"Country\" cc ON cc.\"Id\" = cu.\"CountryId\" LEFT JOIN \"Inventory\".\"EmployeeTable\" se ON se.\"Id\" = sh.\"SaleEmployeeId\" JOIN \"Inventory\".\"CompanyTable\" co ON co.\"Id\" = sh.\"CompanyId\" LEFT JOIN \"Inventory\".\"Town\" cot ON cot.\"Id\" = co.\"TownId\" LEFT JOIN \"Inventory\".\"Country\" coc ON coc.\"Id\" = co.\"CountryId\" LEFT JOIN \"Inventory\".\"Town\" st ON st.\"Id\" = sh.\"TownId\" ORDER BY sh.\"InvoiceDate\" ",
