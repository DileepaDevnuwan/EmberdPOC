  {
    "code": "gfdgfd",
    "name": "fdgfdg",
    "description": null,
    "moduleScope": "SALES",
    "dataSourceType": 1,
    "sourceDatasetId": null,
    "connectionString": null,
    "dbProvider": null,
    "sqlQuery": "SELECT lp.\"Code\" AS \"LearningPlanCode\", \nlp.\"Name\" AS \"LearningPlanName\", \npp.\"Code\" AS \"PlanProgramCode\", \nlp_master.\"Name\" AS \"ProgramName\", \ndc.\"Code\" AS \"DesignProgramCode\", \nCASE WHEN dc.\"Code\" LIKE 'CSE%' THEN 'Course' \nWHEN dc.\"Code\" LIKE 'EVE%' THEN 'Event' \nWHEN dc.\"Code\" LIKE 'DD%' THEN 'Diploma' \nELSE 'Other' END AS \"ProgramClassification\", \nCASE WHEN dc.\"Code\" LIKE 'CSE%' THEN 'Course' \nWHEN dc.\"Code\" LIKE 'EVE%' THEN 'Event' \nWHEN dc.\"Code\" LIKE 'DD%' THEN 'Diploma' \nELSE 'Other' END AS \"ProgramType\", \nCASE WHEN inst.\"Name\" IS NOT NULL THEN 'External' \nELSE 'In-house' END AS \"InHouseExternal\", \n( SELECT STRING_AGG(d.\"Name\", ', ') FROM jsonb_array_elements_text( \nCASE WHEN jsonb_typeof(pp.\"DepartmentIds\"::jsonb) = 'array' THEN pp.\"DepartmentIds\"::jsonb \nELSE '[]'::jsonb END ) AS dept_id \nJOIN \"EnterpriseDataManagement\".\"Departments\" d ON d.\"Id\"::text = dept_id \nWHERE d.\"IsDeleted\" = false ) AS \"Department\", \ninst.\"Name\" AS \"InstituteOrganization\", \nCASE dc.\"ProgramMode\" WHEN 0 THEN 'Online' \nWHEN 1 THEN 'In-person' \nWHEN 2 THEN 'Hybrid' \nELSE dc.\"ProgramMode\"::text END AS \"ProgramMode\", \ncb.\"Code\" AS \"BatchCode\", cb.\"Name\" AS \"BatchName\", \npp.\"TentativeFrom\" AS \"From\", \npp.\"TentativeTo\" AS \"To\", \npp.\"NoOfAttendees\" AS \"TotalAttendees\", \npp.\"AllocatedCost\" AS \"Cost\", \nCASE pp.\"Status\" \nWHEN 0 THEN 'Active' \nWHEN 1 THEN 'Inactive' \nWHEN 2 THEN 'Removed' \nWHEN 3 THEN 'Hide' \nWHEN 4 THEN 'Reject' \nWHEN 5 THEN 'Ended' \nWHEN 6 THEN 'Deprecated' \nWHEN 7 THEN 'Archived' \nWHEN 8 THEN 'Purged' \nWHEN 9 THEN 'Draft' \nWHEN 10 THEN 'Approved' \nWHEN 11 THEN 'Terminated' \nWHEN 12 THEN 'Amended' \nWHEN 13 THEN 'Renewed' \nWHEN 14 THEN 'Addended' \nWHEN 15 THEN 'Extended' \nWHEN 16 THEN 'Superseded' \nWHEN 17 THEN 'TerminationApproved' \nWHEN 18 THEN 'AutoCancelled' \nWHEN 19 THEN 'NotConfigured' \nWHEN 20 THEN 'Cancelled' \nWHEN 21 THEN 'Pending' \nWHEN 22 THEN 'ReferBack' \nWHEN 23 THEN 'Completed' \nELSE pp.\"Status\"::text END AS \"ProgramStatus\", \nSTRING_AGG( DISTINCT CASE WHEN pba.\"EmployeeId\" IS NOT NULL \nTHEN 'Attendee Name: ' || COALESCE(emp.\"FirstName\", '') \n|| ' ' || COALESCE(emp.\"LastName\", '') \n|| E'\\n' || 'Designation: ' \n|| COALESCE(emp_desg.\"Name\", '') \n|| E'\\n' || 'Department: ' \n|| COALESCE(emp_dept.\"Name\", '') \nELSE NULL END, E'\\n\\n' ) AS \"InternalAttendee\", \nSTRING_AGG( DISTINCT CASE WHEN pba.\"ExternalTraineeId\" IS NOT NULL THEN 'Attendee Name: ' \n|| COALESCE(ext.\"ExternalTraineeName\", '') || E'\\n' \n|| 'Designation: ' || '' || E'\\n' \n|| 'Department: ' \n|| COALESCE(ext.\"AcademicEntity\", '') ELSE NULL END, E'\\n\\n' ) AS \"ExternalAttendee\" \nFROM \"Lnd\".\"LearningPlans\" lp INNER JOIN \"Lnd\".\"LearningPlanPrograms\" lpp ON lp.\"Id\" = lpp.\"LearningPlanId\" \nINNER JOIN \"Lnd\".\"PlanPrograms\" pp ON lpp.\"PlanProgramId\" = pp.\"Id\" \nLEFT JOIN \"Lnd\".\"LearningPrograms\" lp_master ON pp.\"LearningProgramId\" = lp_master.\"Id\" \nAND lp_master.\"IsDeleted\" = false LEFT JOIN \"Lnd\".\"DesignCourses\" dc ON pp.\"Id\" = dc.\"PlanProgramId\" \nAND dc.\"IsDeleted\" = false LEFT JOIN \"Lnd\".\"Institutes\" inst ON dc.\"InstituteId\" = inst.\"Id\" \nAND inst.\"IsDeleted\" = false LEFT JOIN \"Lnd\".\"CourseBatches\" cb ON dc.\"Id\" = cb.\"DesignCourseId\" \nAND cb.\"IsDeleted\" = false LEFT JOIN \"Lnd\".\"ProgramBatchAttendees\" pba ON cb.\"Id\" = pba.\"CourseBatchId\" \nAND pba.\"IsDeleted\" = false LEFT JOIN \"HumanResource\".\"Employees\" emp ON pba.\"EmployeeId\" = emp.\"Id\" \nAND emp.\"IsDeleted\" = false LEFT JOIN \"EnterpriseDataManagement\".\"Departments\" emp_dept ON emp.\"DepartmentId\" = emp_dept.\"Id\" \nAND emp_dept.\"IsDeleted\" = false LEFT JOIN \"HumanResource\".\"Designations\" emp_desg ON emp.\"DesignationId\" = emp_desg.\"Id\" \nAND emp_desg.\"IsDeleted\" = false LEFT JOIN \"Lnd\".\"ExternalTrainees\" ext ON pba.\"ExternalTraineeId\" = ext.\"Id\" \nAND ext.\"IsDeleted\" = false WHERE lp.\"IsDeleted\" = false \nAND lpp.\"IsDeleted\" = false \nAND pp.\"IsDeleted\" = false \nGROUP BY lp.\"Code\", \nlp.\"Name\", \npp.\"Code\", \nlp_master.\"Name\", \ndc.\"Id\", \ndc.\"Code\", \ndc.\"ProgramMode\", \ninst.\"Name\", \ncb.\"Code\", \ncb.\"Name\", \npp.\"TentativeFrom\", \npp.\"TentativeTo\", \npp.\"NoOfAttendees\", \npp.\"AllocatedCost\", \npp.\"DepartmentIds\", \npp.\"Status\";",
    "dataSourceId": "97479007-8c46-448b-a385-547fbdc31174",
