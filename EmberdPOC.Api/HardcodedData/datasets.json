    "connectionString": null,
    "dbProvider": null,
    "sqlQuery": "SELECT \"Sales\".\"SaleNo\" AS \"SaleNo\",\n       \"Customers\".\"Name\" AS \"Name\",\n       \"Sales\".\"SaleDate\" AS \"SaleDate\",\n       \"Sales\".\"SubTotalDiscount\" AS \"SubTotalDiscount\",\n       \"Sales\".\"TotalAmount\" AS \"TotalAmount\",\n       \"Sales\".\"NetAmount\" AS \"NetAmount\",\n       \"Payments\".\"PaymentMethod\" AS \"PaymentMethod\",\n       \"Payments\".\"Amount\" AS \"Amount\"\nFROM \"public\".\"Sales\" \"Sales\"\nINNER JOIN \"public\".\"SaleItems\" \"SaleItems\" ON \"Sales\".\"Id\" = \"SaleItems\".\"SaleId\"\nINNER JOIN \"public\".\"Customers\" \"Customers\" ON \"Sales\".\"CustomerId\" = \"Customers\".\"Id\"\nINNER JOIN \"public\".\"Payments\" \"Payments\" ON \"Sales\".\"Id\" = \"Payments\".\"SaleId\"",
    "dataSourceId": "e1909cc3-511c-428f-910e-acc47f7857e7",
    "queryDesignJson": "{\"version\":1,\"tables\":[{\"id\":\"t1\",\"schema\":\"public\",\"name\":\"Sales\",\"alias\":\"Sales\",\"x\":17,\"y\":14},{\"id\":\"t2\",\"schema\":\"public\",\"name\":\"SaleItems\",\"alias\":\"SaleItems\",\"x\":913,\"y\":133},{\"id\":\"t3\",\"schema\":\"public\",\"name\":\"Customers\",\"alias\":\"Customers\",\"x\":401,\"y\":199},{\"id\":\"t4\",\"schema\":\"public\",\"name\":\"Payments\",\"alias\":\"Payments\",\"x\":1349,\"y\":12}],\"joins\":[{\"id\":\"j1\",\"leftTableId\":\"t1\",\"rightTableId\":\"t2\",\"type\":\"Inner\",\"keys\":[{\"leftColumn\":\"Id\",\"rightColumn\":\"SaleId\"}]},{\"id\":\"j2\",\"leftTableId\":\"t1\",\"rightTableId\":\"t3\",\"type\":\"Inner\",\"keys\":[{\"leftColumn\":\"CustomerId\",\"rightColumn\":\"Id\"}]},{\"id\":\"j3\",\"leftTableId\":\"t1\",\"rightTableId\":\"t4\",\"type\":\"Inner\",\"keys\":[{\"leftColumn\":\"Id\",\"rightColumn\":\"SaleId\"}]}],\"columns\":[{\"id\":\"c1\",\"kind\":\"Column\",\"tableId\":\"t1\",\"column\":\"SaleNo\",\"alias\":\"SaleNo\",\"output\":true,\"sort\":\"None\"},{\"id\":\"c2\",\"kind\":\"Column\",\"tableId\":\"t3\",\"column\":\"Name\",\"alias\":\"Name\",\"output\":true,\"sort\":\"None\"},{\"id\":\"c3\",\"kind\":\"Column\",\"tableId\":\"t1\",\"column\":\"SaleDate\",\"alias\":\"SaleDate\",\"output\":true,\"sort\":\"None\"},{\"id\":\"c4\",\"kind\":\"Column\",\"tableId\":\"t1\",\"column\":\"SubTotalDiscount\",\"alias\":\"SubTotalDiscount\",\"output\":true,\"sort\":\"None\"},{\"id\":\"c5\",\"kind\":\"Column\",\"tableId\":\"t1\",\"column\":\"TotalAmount\",\"alias\":\"TotalAmount\",\"output\":true,\"sort\":\"None\"},{\"id\":\"c6\",\"kind\":\"Column\",\"tableId\":\"t1\",\"column\":\"NetAmount\",\"alias\":\"NetAmount\",\"output\":true,\"sort\":\"None\"},{\"id\":\"c7\",\"kind\":\"Column\",\"tableId\":\"t4\",\"column\":\"PaymentMethod\",\"alias\":\"PaymentMethod\",\"output\":true,\"sort\":\"None\"},{\"id\":\"c8\",\"kind\":\"Column\",\"tableId\":\"t4\",\"column\":\"Amount\",\"alias\":\"Amount\",\"output